  <script>(function(){function m(a){var h=a.getAttribute("href");if(!h)return;try{var u=new URL(h,document.baseURI);if((u.protocol==="http:"||u.protocol==="https:")&&u.host!==location.host){a.target="_blank";a.rel="noopener noreferrer";}}catch(e){}}function s(){document.querySelectorAll("a[href]").forEach(m);}if(document.readyState!=="loading"){s();}else{document.addEventListener("DOMContentLoaded",s);}document.addEventListener("click",function(e){var a=e.target&&e.target.closest&&e.target.closest("a[href]");if(a){m(a);}},true);})();</script>

<script>
/* ARGENTAS — funciones integradas de interfaz y accesibilidad.
   Estas funciones forman parte de la aplicación standalone y no modifican
   el código React mediante parches externos. */
(function(){
  'use strict';
  const qs=(s,r=document)=>r.querySelector(s);
  const qsa=(s,r=document)=>Array.from(r.querySelectorAll(s));
  const text=(el)=>el&&el.textContent?el.textContent.trim():'';
  function findText(selector, fragment){
    const f=String(fragment).toUpperCase();
    return qsa(selector).find(el=>text(el).toUpperCase().includes(f))||null;
  }
  function today(){
    return new Date().toLocaleDateString('es-AR',{day:'numeric',month:'long',year:'numeric'}).toUpperCase();
  }
  function applyDateTitle(){
    qsa('h1,h2,div,span').forEach(el=>{
      Array.from(el.childNodes).forEach(n=>{
        if(n.nodeType===3 && n.textContent.trim()==='HOY EN') n.textContent='ACTIVIDAD DE';
      });
    });
    const s=findText('span','PUNTA LARA');
    if(s && !s.dataset.argentasDate) { s.textContent=today(); s.dataset.argentasDate='1'; }
  }
  function cleanPlaceholder(){
    qsa('div,span,p').forEach(el=>{
      if(!el.children.length && text(el).includes('Placeholder') && text(el).includes('facilita conteo'))
        el.textContent='El campo ya viene con el monto esperado. Borralo si querés contar a mano.';
    });
  }
  function installBeachMode(){
    if(qs('#argentas-beach-mode')) return;
    const state=qsa('div').find(el=>!el.children.length && ['ABIERTA','CERRADA'].includes(text(el)));
    if(!state||!state.parentElement) return;
    const b=document.createElement('button');
    b.id='argentas-beach-mode'; b.type='button'; b.title='Modo Playa (alto contraste)'; b.textContent='☀';
    Object.assign(b.style,{width:'30px',height:'30px',minWidth:'30px',borderRadius:'999px',background:'#111',color:'#E8B84A',fontSize:'14px',display:'inline-flex',alignItems:'center',justifyContent:'center',border:'2px solid #E8B84A',cursor:'pointer',fontWeight:'900',marginLeft:'6px',flexShrink:'0'});
    const active=localStorage.getItem('argentas_modo_playa')==='1';
    const set=(on)=>{document.body.classList.toggle('argentas-beach',on);b.classList.toggle('active',on);b.style.background=on?'#E8B84A':'#111';b.style.color=on?'#000':'#E8B84A';b.style.borderColor=on?'#000':'#E8B84A';localStorage.setItem('argentas_modo_playa',on?'1':'0');};
    b.onclick=()=>set(!document.body.classList.contains('argentas-beach'));
    state.parentElement.appendChild(b); set(active);
  }
  function installTodo(){
    const original=findText('button','USAR ESPERADO');
    if(!original||qs('#argentas-todo')) return;
    const b=document.createElement('button'); b.id='argentas-todo'; b.type='button'; b.textContent='✅ TODO COINCIDE'; b.title='Usa el monto esperado';
    Object.assign(b.style,{display:'inline-flex',alignItems:'center',justifyContent:'center',gap:'6px',marginTop:'6px',width:'100%',padding:'10px',borderRadius:'10px',background:'#16a34a',color:'#fff',fontWeight:'900',fontSize:'12px',letterSpacing:'.05em',border:'none',cursor:'pointer'});
    b.onclick=()=>original.click(); original.insertAdjacentElement('afterend',b);
  }
  function installWhatsApp(){
    if(window.__argentasWaInstalled) return;
    if(!navigator.clipboard || !navigator.clipboard.writeText) return;
    window.__argentasWaInstalled=true;
    const original=navigator.clipboard.writeText.bind(navigator.clipboard);
    navigator.clipboard.writeText=(value)=>{
      const result=original(value);
      if(typeof value==='string' && value.includes('ARGENTAS')){
        const m=value.match(/[\s\S]*✨ Ganancia:[^\n]*/); const send=m?m[0]:value;
        setTimeout(()=>window.open('https://wa.me/?text='+encodeURIComponent(send),'_blank'),300);
      }
      return result;
    };
  }
  function run(){applyDateTitle();cleanPlaceholder();installBeachMode();installTodo();installWhatsApp();}
  const style=document.createElement('style');
  style.textContent=`body.argentas-beach,body.argentas-beach *{text-shadow:none!important}body.argentas-beach{filter:contrast(1.35) brightness(1.08)}body.argentas-beach [class*="text-zinc-500"],body.argentas-beach [class*="text-zinc-600"],body.argentas-beach [class*="text-zinc-400"]{color:#fff!important;font-weight:900!important}body.argentas-beach [class*="text-[10px]"],body.argentas-beach [class*="text-[11px]"]{font-size:14px!important}body.argentas-beach button{border-width:2px!important}`;
  document.head.appendChild(style);
  new MutationObserver(()=>setTimeout(run,120)).observe(document.documentElement,{childList:true,subtree:true});
  window.addEventListener('load',run); document.addEventListener('DOMContentLoaded',run); setTimeout(run,300);
})();
</script>


<script>
(function(){
  let lastModal=null;
  const QR_SCRIPT='https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js';
  function loadQR(cb){
    if(window.QRCode){cb();return;}
    const sc=document.createElement('script');sc.src=QR_SCRIPT;sc.onload=cb;document.head.appendChild(sc);
  }
  function moneyFromModal(modal){
    const t=(modal.innerText||'').match(/TOTAL:\s*\$?\s*([0-9.,]+)/i);
    return t?t[1]:'0';
  }
  function closeQR(){
    const x=document.getElementById('argentas-qr-demo'); if(x)x.remove();
  }
  function showQR(amount){
    closeQR();
    const ov=document.createElement('div');ov.id='argentas-qr-demo';
    ov.style.cssText='position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;padding:16px;background:rgba(0,0,0,.82);backdrop-filter:blur(5px);';
    const box=document.createElement('div');
    box.style.cssText='width:min(92vw,420px);background:#141414;border:1px solid rgba(232,184,74,.35);border-radius:24px;padding:22px;box-shadow:0 20px 80px rgba(0,0,0,.85);color:white;text-align:center;';
    box.innerHTML='<div style="font-family:Arial,sans-serif;font-size:16px;font-weight:900;letter-spacing:.12em;margin-bottom:4px">PAGO CON QR</div><div style="font-size:11px;font-weight:700;letter-spacing:.08em;color:#888;margin-bottom:16px">MOSTRÁ ESTE CÓDIGO AL CLIENTE</div><div id="argentas-qr-code" style="width:240px;height:240px;margin:0 auto;background:white;padding:10px;border-radius:12px;display:flex;align-items:center;justify-content:center"></div><div style="font-family:Arial,sans-serif;font-size:34px;font-weight:900;color:#E8B84A;margin-top:16px">$'+amount+'</div><div style="font-size:10px;font-weight:800;letter-spacing:.12em;color:#777;margin-top:5px">QR INTEROPERABLE • DEMOSTRACIÓN VISUAL</div><button id="argentas-qr-confirm" style="margin-top:18px;width:100%;height:46px;border:0;border-radius:999px;background:#E8B84A;color:#111;font-size:11px;font-weight:900;letter-spacing:.12em">CONFIRMAR PAGO</button><button id="argentas-qr-close" style="margin-top:9px;width:100%;height:42px;border-radius:999px;background:transparent;border:1px solid #333;color:#aaa;font-size:10px;font-weight:900;letter-spacing:.12em">VOLVER</button>';
    ov.appendChild(box);document.body.appendChild(ov);
    const render=()=>{
      const el=document.getElementById('argentas-qr-code');
      if(el&&window.QRCode){
        new QRCode(el,{text:'ARGENTAS-DEMO|MONTO='+amount,width:220,height:220,correctLevel:QRCode.CorrectLevel.M});
      }
    };
    loadQR(render);
    document.getElementById('argentas-qr-close').onclick=closeQR;
    document.getElementById('argentas-qr-confirm').onclick=function(){
      this.textContent='PAGO CONFIRMADO';this.style.background='#22c55e';
      /*
       * En la demo, "Pago confirmado" termina la venta de verdad:
       * dispara el botón TRANSFERENCIA del cierre original, que es
       * el mecanismo real de Argentas para registrar y cerrar la venta.
       * Luego volvemos a VENDER con el pedido ya vacío.
       */
      setTimeout(()=>{
        const candidates=[...document.querySelectorAll('div,section')].filter(el=>{
          const tx=(el.innerText||'').trim();
          return tx.includes('¿CÓMO COBRASTE?') && tx.includes('TRANSFERENCIA');
        });
        const modal=candidates.sort((a,b)=>a.innerText.length-b.innerText.length)[0];
        const transfer=modal && [...modal.querySelectorAll('button')].find(b=>(b.innerText||'').includes('TRANSFERENCIA'));
        closeQR();
        if(transfer) transfer.click();
      },350);
    };
    ov.addEventListener('click',e=>{if(e.target===ov)closeQR()});
  }
  function install(){
    const candidates=[...document.querySelectorAll('div,section')].filter(el=>{
      const tx=(el.innerText||'').trim();
      return tx.includes('¿CÓMO COBRASTE?') && tx.includes('TRANSFERENCIA') && tx.includes('MIXTA');
    });
    const modal=candidates.sort((a,b)=>a.innerText.length-b.innerText.length)[0];
    if(!modal || modal===lastModal)return;
    lastModal=modal;
    const buttons=[...modal.querySelectorAll('button')];
    const transfer=buttons.find(b=>(b.innerText||'').includes('TRANSFERENCIA'));
    if(!transfer)return;
    const b=document.createElement('button');
    b.type='button';b.setAttribute('data-argentas-qr','1');
    b.style.cssText='height:72px;border-radius:16px;background:linear-gradient(90deg,#111,#1b1b1b,#1E3A8A);border:2px solid #E8B84A;color:white;display:flex;align-items:center;gap:16px;padding:0 20px;width:100%;text-align:left;cursor:pointer;box-shadow:0 6px 20px rgba(232,184,74,.22);';
    b.innerHTML='<div style="width:48px;height:48px;border-radius:50%;background:#fff;color:#111;display:flex;align-items:center;justify-content:center;font-size:23px;font-weight:900">▦</div><div><div style="font-family:Arial,sans-serif;font-size:18px;font-weight:900;letter-spacing:.08em;line-height:1">QR</div><div style="font-size:10px;font-weight:900;letter-spacing:.12em;color:#E8B84A;margin-top:5px">PAGO CON BILLETERA VIRTUAL</div></div><div style="margin-left:auto;font-size:18px;font-weight:900">›</div>';
    b.onclick=()=>showQR(moneyFromModal(modal));
    transfer.parentNode.insertBefore(b,transfer.nextSibling);
  }
  const obs=new MutationObserver(install);obs.observe(document.documentElement,{childList:true,subtree:true});
  setInterval(install,500);
})();
</script>
</body>
</html>