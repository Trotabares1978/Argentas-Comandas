        .font-display{font-family:'Archivo Black','Bebas Neue',sans-serif; letter-spacing:0.02em;}
        .font-chalk{font-family:'Archivo Black',sans-serif; letter-spacing:0.06em; filter: contrast(1.1) brightness(1.05);}
        .text-gold{color:#E8B84A;}
        .bg-gold{background:#E8B84A;}
        .border-gold{border-color:#E8B84A;}
        .brush-blue{
          background:#1E3A8A;
          position:relative;
          transform: rotate(-1.5deg);
          box-shadow: 0 2px 0 rgba(0,0,0,0.4);
        }
        .brush-blue::after{
          content:'';
          position:absolute;
          inset:0;
          background: linear-gradient(90deg, transparent 0%, rgba(255,255,255,0.08) 50%, transparent 100%);
          mix-blend-mode: overlay;
        }
        .fire-edge{
          background: radial-gradient(120% 80% at 50% 100%, rgba(255,120,20,0.35) 0%, rgba(200,40,0,0.25) 20%, rgba(0,0,0,0) 60%),
                      radial-gradient(100% 60% at 0% 100%, rgba(255,80,0,0.25) 0%, transparent 50%),
                      radial-gradient(100% 60% at 100% 100%, rgba(255,100,10,0.25) 0%, transparent 50%);
        }
        .chalk-text{
          text-shadow: 0 0 1px rgba(255,255,255,0.8), 0 1px 0 rgba(255,255,255,0.2), 0 -1px 0 rgba(0,0,0,0.5);
          -webkit-text-stroke: 0.4px rgba(255,255,255,0.15);
        }
        @keyframes pop { 0%{transform:scale(1)} 40%{transform:scale(1.06)} 100%{transform:scale(1)} }
        .animate-pop{animation: pop 0.35s ease}
