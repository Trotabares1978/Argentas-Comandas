)}),X("div",{className:"flex-1",children:[P("div",{className:"font-display text-[15px] tracking-widest text-white",children:"¿BORRAR ESTE CIERRE?"}),X("div",{className:"mt-2 text-[13px] font-bold text-zinc-300 leading-snug",children:["¿Seguro que querés borrar el cierre del ",P("span",{className:"text-white",children:new Date(de.closedAt).toLocaleDateString("es-AR",{weekday:"long",day:"numeric",month:"long"})}),"?"]}),X("div",{className:"mt-2 text-[11px] font-bold text-zinc-500",children:["Total: ",N(de.totals.totalSold)," • ",de.sales.length," ventas • Esta acción no se puede deshacer."]}),X("div",{className:"mt-3 bg-black rounded-xl border border-zinc-800 p-3 grid grid-cols-2 gap-2 text-[10px]",children:[X("div",{children:[P("span",{className:"text-zinc-500 font-black tracking-widest",children:"EFECTIVO"}),P("div",{className:"font-display text-[#E8B84A] text-[13px] mt-1",children:N(de.totals.byMethod.Efectivo||0)})]}),X("div",{children:[P("span",{className:"text-zinc-500 font-black tracking-widest",children:"TRANSF"}),P("div",{className:"font-display text-white text-[13px] mt-1",children:N(de.totals.byMethod.Transferencia||0)})]})]})]})]}),X("div",{className:"mt-5 grid grid-cols-2 gap-3",children:[P("button",{onClick:()=>tt(null),className:"h-11 rounded-full bg-black border border-zinc-800 text-zinc-300 font-black tracking-widest text-[11px]",children:"Cancelar"}),X("button",{onClick:p8,className:"h-11 rounded-full bg-red-600 hover:bg-red-500 text-white font-black tracking-widest text-[11px] flex items-center justify-center gap-2 shadow-[0_6px_20px_rgba(220,38,38,0.35)] active:scale-[0.98]",children:[P(Pe,{className:"w-4 h-4"})," Sí, borrar"]})]})]})]}),J&&X("div",{className:"fixed bottom-[88px] md:bottom-6 left-1/2 -translate-x-1/2 z-[70] bg-[#E8B84A] text-black px-5 py-3 rounded-full text-[12px] font-black tracking-widest shadow-[0_10px_30px_rgba(232,184,74,0.4)] animate-pop flex items-center gap-2",children:[P("span",{children:"\uD83D\uDD25"}),P("span",{childre