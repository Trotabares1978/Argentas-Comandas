  <script>(function(){function m(a){var h=a.getAttribute("href");if(!h)return;try{var u=new URL(h,document.baseURI);if((u.protocol==="http:"||u.protocol==="https:")&&u.host!==location.host){a.target="_blank";a.rel="noopener noreferrer";}}catch(e){}}function s(){document.querySelectorAll("a[href]").forEach(m);}if(document.readyState!=="loading"){s();}else{document.addEventListener("DOMContentLoaded",s);}document.addEventListener("click",function(e){var a=e.target&&e.target.closest&&e.target.closest("a[href]");if(a){m(a);}},true);})();</script>
  

<!-- ============================================================ -->
<!-- PARCHE ARGENTAS: Modo Playa + WhatsApp directo + Cierre rápido -->
<!-- Capa agregada sin modificar el código original de la app      -->
<!-- ============================================================ -->
<style id="argentas-patch-style">
  /* ---------- MODO PLAYA (alto contraste / sol directo) ---------- */
  body.modo-playa, body.modo-playa * {
    text-shadow: none !important;
  }
  body.modo-playa {
    filter: contrast(1.35) brightness(1.08);
  }
  body.modo-playa [class*="text-zinc-500"],
  body.modo-playa [class*="text-zinc-600"],
  body.modo-playa [class*="text-zinc-400"] {
    color: #ffffff !important;
    font-weight: 900 !important;
  }
  body.modo-playa [class*="text-\[10px\]"],
  body.modo-playa [class*="text-\[11px\]"] {
    font-size: 14px !important;
  }
  body.modo-playa button {
    border-width: 2px !important;
  }

  /* ---------- Botón Modo Playa: fijo al lado del indicador ABIERTA/CERRADA ---------- */
  #btn-modo-playa {
    width: 30px;
    height: 30px;
    min-width: 30px;
    border-radius: 999px;
    background: #111;
    color: #E8B84A;
    font-size: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #E8B84A;
    cursor: pointer;
    font-weight: 900;
    margin-left: 6px;
    flex-shrink: 0;
  }
  #btn-modo-playa.activo {
    background: #E8B84A;
    color: #000;
    border: 2px solid #000;
  }

  /* ---------- Botón WhatsApp directo ---------- */
  #btn-wa-directo {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 8px;
    width: 100%;
    justify-content: center;
    padding: 10px;
    border-radius: 10px;
    background: #25D366;
    color: #fff;
    font-weight: 900;
    font-size: 12px;
    letter-spacing: 0.05em;
    border: none;
    cursor: pointer;
  }

  /* ---------- Botón "Usar esperado" ya existe, agregamos "Todo coincide" ---------- */
  #btn-todo-coincide {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
    width: 100%;
    justify-content: center;
    padding: 10px;
    border-radius: 10px;
    background: #16a34a;
    color: #fff;
    font-weight: 900;
    font-size: 12px;
    letter-spacing: 0.05em;
    border: none;
    cursor: pointer;
  }
</style>

<script id="argentas-patch-script">
(function () {
  "use strict";

  // ---------------------------------------------------------------
  // Utilidad: encuentra un elemento por texto exacto/parcial visible
  // ---------------------------------------------------------------
  function findByText(selector, textFragment) {
    var els = document.querySelectorAll(selector);
    for (var i = 0; i < els.length; i++) {
      if (els[i].textContent && els[i].textContent.trim().toUpperCase().includes(textFragment.toUpperCase())) {
        return els[i];
      }
    }
    return null;
  }

  function findNumberNear(labelText) {
    // Busca un bloque que contenga labelText y devuelve el número más cercano en el mismo contenedor
    var label = findByText("*", labelText);
    if (!label) return null;
    var container = label.closest("div");
    if (!container) return null;
    var match = container.textContent.match(/[\d.,]+/g);
    return match ? match : null;
  }

  // ---------------------------------------------------------------
  // 1) MODO PLAYA
  // ---------------------------------------------------------------
  function initModoPlaya() {
    if (document.getElementById("btn-modo-playa")) return;

    // Buscamos el indicador chico de estado de caja en mobile: "ABIERTA" o "CERRADA"
    var indicador = null;
    var candidatos = document.querySelectorAll("div");
    for (var i = 0; i < candidatos.length; i++) {
      var texto = candidatos[i].textContent.trim();
      if ((texto === "ABIERTA" || texto === "CERRADA") && candidatos[i].children.length === 0) {
        indicador = candidatos[i];
        break;
      }
    }
    if (!indicador || !indicador.parentElement) return; // reintenta en el próximo ciclo

    var btn = document.createElement("button");
    btn.id = "btn-modo-playa";
    btn.title = "Modo Playa (alto contraste)";
    btn.textContent = "☀";
    btn.addEventListener("click", function () {
      document.body.classList.toggle("modo-playa");
      btn.classList.toggle("activo");
      try {
        localStorage.setItem(
          "argentas_modo_playa",
          document.body.classList.contains("modo-playa") ? "1" : "0"
        );
      } catch (e) {}
    });
    indicador.parentElement.appendChild(btn);

    try {
      if (localStorage.getItem("argentas_modo_playa") === "1") {
        document.body.classList.add("modo-playa");
        btn.classList.add("activo");
      }
    } catch (e) {}
  }

  // ---------------------------------------------------------------
  // 2) WHATSAPP DIRECTO
  //    La app arma el resumen y lo copia con navigator.clipboard.writeText().
  //    No hay textarea visible en pantalla: interceptamos esa llamada.
  //    Cada vez que la app copie el resumen (empieza con "*ARGENTAS"),
  //    abrimos WhatsApp con ese mismo texto automáticamente.
  // ---------------------------------------------------------------
  function initWhatsappDirecto() {
    if (navigator.clipboard && navigator.clipboard.__argentasPatched) return;
    if (!navigator.clipboard || !navigator.clipboard.writeText) return;

    var original = navigator.clipboard.writeText.bind(navigator.clipboard);
    navigator.clipboard.writeText = function (text) {
      var result = original(text);
      try {
        if (typeof text === "string" && text.indexOf("ARGENTAS") !== -1) {
          var textoRecortado = text;
          // Cortamos todo lo que sigue después de la línea de Ganancia
          // (precios de milanesas y firma final quedan afuera del envío)
          var match = text.match(/[\s\S]*✨ Ganancia:[^\n]*/);
          if (match) {
            textoRecortado = match[0];
          }
          var url = "https://wa.me/?text=" + encodeURIComponent(textoRecortado);
          // Pequeño delay para no pisar el mensaje "Resumen copiado" de la app
          setTimeout(function () {
            window.open(url, "_blank");
          }, 300);
        }
      } catch (e) {}
      return result;
    };
    navigator.clipboard.__argentasPatched = true;
  }

  // ---------------------------------------------------------------
  // 2b) TÍTULO: "HOY EN / PUNTA LARA" -> "ACTIVIDAD DE / <fecha de hoy>"
  // ---------------------------------------------------------------
  function fechaHoyLarga() {
    var hoy = new Date();
    var opciones = { day: "numeric", month: "long", year: "numeric" };
    var texto = hoy.toLocaleDateString("es-AR", opciones);
    // Ej: "17 de septiembre de 2026" -> lo dejamos en mayúsculas para calzar con el estilo
    return texto.toUpperCase();
  }

  function initTituloFecha() {
    var candidatos = document.querySelectorAll("h1, h2, div, span");
    for (var i = 0; i < candidatos.length; i++) {
      var el = candidatos[i];
      // Buscamos el nodo que tiene el texto "HOY EN" directamente (no en hijos)
      var hijos = el.childNodes;
      for (var j = 0; j < hijos.length; j++) {
        if (hijos[j].nodeType === 3 && hijos[j].textContent.trim() === "HOY EN") {
          if (!hijos[j].__argentasPatched) {
            hijos[j].textContent = "ACTIVIDAD DE";
            hijos[j].__argentasPatched = true;
          }
        }
      }
    }
    var spanPuntaLara = findByText("span", "PUNTA LARA");
    if (spanPuntaLara && !spanPuntaLara.__argentasFechaPatched) {
      spanPuntaLara.textContent = fechaHoyLarga();
      spanPuntaLara.__argentasFechaPatched = true;
    }
  }

  // ---------------------------------------------------------------
  // 4) LIMPIEZA DE TEXTO TÉCNICO: nota "Placeholder = esperado..."
  //    Se reemplaza por una explicación en lenguaje simple.
  // ---------------------------------------------------------------
  function initLimpiarNotaPlaceholder() {
    var nodos = document.querySelectorAll("div, span, p");
    for (var i = 0; i < nodos.length; i++) {
      var el = nodos[i];
      if (
        el.children.length === 0 &&
        el.textContent &&
        el.textContent.indexOf("Placeholder") !== -1 &&
        el.textContent.indexOf("facilita conteo") !== -1 &&
        !el.__argentasNotaPatched
      ) {
        el.textContent = "El campo ya viene con el monto esperado. Borralo si querés contar a mano.";
        el.__argentasNotaPatched = true;
      }
    }
  }

  // ---------------------------------------------------------------
  // 5) CIERRE RÁPIDO DE CAJA ("Todo coincide")
  //    Busca el botón "USAR ESPERADO" (ya existente) y agrega uno
  //    al lado que copia el esperado en TODOS los inputs de conteo
  //    y dispara el mismo botón "USAR ESPERADO" para reusar su lógica.
  // ---------------------------------------------------------------
  function initTodoCoincide() {
    var usarEsperado = findByText("button", "USAR ESPERADO");
    if (!usarEsperado) return;
    if (usarEsperado.parentElement.querySelector("#btn-todo-coincide")) return;

    var btn = document.createElement("button");
    btn.id = "btn-todo-coincide";
    btn.innerHTML = "✅ TODO COINCIDE";
    btn.title = "Usa el monto esperado en efectivo y transferencia sin re-tipear";
    btn.addEventListener("click", function () {
      // Reutiliza la lógica ya probada de "USAR ESPERADO" del sistema original
      usarEsperado.click();
    });
    usarEsperado.insertAdjacentElement("afterend", btn);
  }

  // ---------------------------------------------------------------
  // Observador: la app es React, el DOM cambia dinámicamente.
  // Reintentamos montar los botones cada vez que cambia el árbol.
  // ---------------------------------------------------------------
  var debounceTimer = null;
  function runAll() {
    initModoPlaya();
    initWhatsappDirecto();
    initTituloFecha();
    initLimpiarNotaPlaceholder();
    initTodoCoincide();
  }

  function scheduleRun() {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(runAll, 150);
  }

  document.addEventListener("DOMContentLoaded", scheduleRun);
  window.addEventListener("load", scheduleRun);

  var observer = new MutationObserver(scheduleRun);
  observer.observe(document.documentElement, { childList: true, subtree: true });

  // Primer intento inmediato por si el DOM ya está listo
  scheduleRun();
})();
</script>

</body>
</html>